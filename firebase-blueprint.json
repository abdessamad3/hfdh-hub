{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "A student enrolled in the Hifdh program",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the student" },
        "age": { "type": "number", "description": "Age of the student" },
        "enrollmentDate": { "type": "string", "format": "date-time", "description": "When the student joined" },
        "teacherId": { "type": "string", "description": "ID of the assigned teacher" }
      },
      "required": ["name", "age", "enrollmentDate", "teacherId"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance record",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["present", "absent"] }
      },
      "required": ["studentId", "date", "status"]
    },
    "Memorization": {
      "title": "Memorization",
      "description": "A record of a memorization session",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "surahName": { "type": "string" },
        "fromAyah": { "type": "number" },
        "toAyah": { "type": "number" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "surahName", "fromAyah", "toAyah", "date"]
    },
    "Evaluation": {
      "title": "Evaluation",
      "description": "Quality assessment of a memorization session (includes memorization details)",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "teacherId": { "type": "string" },
        "surahName": { "type": "string" },
        "fromAyah": { "type": "number" },
        "toAyah": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "mistakesCount": { "type": "number" },
        "accuracyScore": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["studentId", "teacherId", "surahName", "fromAyah", "toAyah", "date", "mistakesCount", "accuracyScore"]
    },
    "Revision": {
      "title": "Revision",
      "description": "A record of a revision session",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "surahName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "qualityScore": { "type": "number" }
      },
      "required": ["studentId", "surahName", "date", "qualityScore"]
    }
  },
  "firestore": {
    "/students/{studentId}": { "schema": "Student", "description": "Collection of students" },
    "/attendance/{attendanceId}": { "schema": "Attendance", "description": "Attendance logs" },
    "/memorizations/{memId}": { "schema": "Memorization", "description": "Memorization records" },
    "/evaluations/{evalId}": { "schema": "Evaluation", "description": "Evaluation sessions" },
    "/revisions/{revId}": { "schema": "Revision", "description": "Revision history" }
  }
}
