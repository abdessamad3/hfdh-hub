,3632,3640,3649,3658,3666,3673,3685,3693,3700,3712,3727,3740,3754,3770,3783,3807,3834,3859,3885,3909,3936,3965,3980,3990,4006,4025,4047,4057,4062,4071,4081,4088,4095,4104,4115,4122,4129,4138,4148,4156,4163,4172,4181,4189,4199,4207,4217,4226,4235,4244,4252,4260,4268,4273,4280,4289,4301,4308,4319,4331,4342,4356,4370,4383,4399,4416,4436,4455,4467,4476,4486,4495,4504,4510,4518,4525,4537,4545,4555,4564,4573,4579,4587,4592,4597,4604,4611,4626,4646,4662,4686,4707,4728,4745,4763,4789,4806,4830,4851,4873,4895,4919,4947,4974,5009,5035,5058,5066,5072,5078,5083,5089,5094,5103,5107,5113,5120,5128,5133,5139,5146,5155,5163,5170,5177,5186,5195,5200,5207,5214,5219,5232,5246,5266,5292,5309,5337,5364,5394,5408,5428,5441,5456,5473,5492,5520,5547,5573,5593,5618,5649,5679,5705,5734,5774,5805,5828,5857,5884,5907,5934,5965,5993,6019,6045,6070,6096,6114,6131,6155,6172,6186,6200,6215'.split(',')[page-1]);
    }
    function warshSurah(surah) {
      return '0:7,7:285,292:200,492:175,667:122,789:167,956:206,1162:76,1238:130,1368:109,1477:121,1598:111,1709:44,1753:54,1807:99,1906:128,2034:110,2144:105,2249:99,2348:134,2482:111,2593:76,2669:119,2788:62,2850:77,2927:226,3153:95,3248:88,3336:69,3405:59,3464:33,3497:30,3527:73,3600:54,3654:46,3700:82,3782:182,3964:86,4050:72,4122:84,4206:53,4259:50,4309:89,4398:56,4454:36,4490:34,4524:39,4563:29,4592:18,4610:45,4655:60,4715:47,4762:61,4823:55,4878:77,4955:99,5054:28,5082:21,5103:24,5127:13,5140:14,5154:11,5165:11,5176:18,5194:12,5206:12,5218:31,5249:52,5301:52,5353:44,5397:30,5427:28,5455:18,5473:55,5528:39,5567:31,5598:50,5648:40,5688:45,5733:42,5775:29,5804:19,5823:36,5859:25,5884:22,5906:17,5923:19,5942:26,5968:32,6000:20,6020:15,6035:21,6056:11,6067:8,6075:8,6083:20,6103:5,6108:8,6116:9,6125:11,6136:10,6146:8,6154:3,6157:9,6166:5,6171:5,6176:6,6182:3,6185:6,6191:3,6194:5,6199:4,6203:5,6208:6'.split(',')[surah-1].split(':');
    }
    function validWarshVerse(d) {
      let book=warshSurah(d.surah);
      return d.edition == 'warsh-kfqc-1442' && d.sourceVersion == 'b4155f07e4aea087d2c458069acff9f7c7e749f6' &&
        d.surah is int && d.surah >= 1 && d.surah <= 114 && d.ayah is int && d.ayah >= 1 && d.ayah <= int(book[1]) &&
        d.page is int && d.page >= 1 && d.page <= 604 && int(book[0]) + d.ayah >= warshPageStart(d.page) && int(book[0]) + d.ayah < warshPageStart(d.page+1);
    }
    match /katatib_verse_marks/{id} {
      allow get: if member() && (!exists(/databases/$(database)/documents/katatib_verse_marks/$(id)) || historyAllowed(resource.data));
      allow list: if request.query.limit <= 100 && historyAllowed(resource.data);
      allow create: if staff() && historyAllowed(request.resource.data) && id.matches('[A-Za-z0-9-]{16,80}') &&
        request.resource.data.keys().hasOnly(['schemaVersion','studentId','edition','sourceVersion','page','surah','ayah','mark','note','createdBy','createdAt']) &&
        request.resource.data.schemaVersion == 1 && validWarshVerse(request.resource.data) && request.resource.data.mark in ['forgot','hesitated','error','correct'] &&
        request.resource.data.note is string && request.resource.data.note.size() <= 500 && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }


    match /{document=**} { allow read, write: if false; }
  }
}
