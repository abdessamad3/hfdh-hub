    function validWarshVerse(d) {
      let book=warshSurah(d.surah);
      return d.edition == 'warsh-kfqc-1442' && d.sourceVersion == 'b4155f07e4aea087d2c458069acff9f7c7e749f6' &&
        d.surah is int && d.surah >= 1 && d.surah <= 114 && d.ayah is int && d.ayah >= 1 && d.ayah <= int(book[1]) &&
        d.page is int && d.page >= 1 && d.page <= 604 && int(book[0]) + d.ayah >= warshPageStart(d.page) && int(book[0]) + d.ayah < warshPageStart(d.page+1);
    }
    function learningBoundary(cell) { return int('10000,230000,320000,400000,480000,600000,660000,730000,820000,910151,980000,1070000,1120000,1200000,1300000,1390000,1480000,1540000,1640000,1720000,1830000,1910000,1950000,2020393,2080000,2180000,2240000,2320000,2380000,2400242,2480000,2530000,2580000,2640000,2690000,2730000,2780000,2860000,2890000,2970000,3070000,3150000,3250000,3340000,3430000,3550000,3660000,3720187,3830000,3950000,4050000,4130000,4250000,4360000,4450000,4520000,4630000,4730000,4780000,4880000,4980000,5030000,5050000,5110209,5160000,5210000,5280000,5370000,5490000,5560000,5650000,5700000,5780000,5830415,5910000,5960000,6050000,6150000,6210000,6310000,6390000,6480089,6570000,6650000,6710000,6740000,6800000,6860000,6920000,7010235,7100000,7140000,7180000,7270000,7360000,7420000,7510000,7590000,7660000,7750000,7800000,7900000,8030000,8160000,8260000,8380000,8490000,8590000,8700000,8810000,8850000,8930000,9010000,9100000,9170000,9250000,9300000,9350000,9410000,9480000,9600000,9760000,9860000,9940000,10020000,10120000,10240000,10320000,10430000,10550000,10720000,10870000,10980000,11050000,11120000,11190000,11270000,11350000,11440000,11550000,11670000,11770000,11840000,11930000,12030000,12110000,12230000,12340000,12430000,12500000,12570000,12660000,12720000,12780000,12840000,12930000,12990000,13080000,13140000,13240000,13320000,13400000,13500000,13560000,13620000,13710000,13790000,13870000,13940000,14050000,14170000,14290000,14390000,14510000,14610000,14720000,14830000,14920000,15010000,15090000,15180000,15300000,15380000,15490000,15600000,15700000,15820000,15940000,16080000,16210000,16310000,16400000,16510000,16640000,16750000,16860000,16990000,17090000,17140000,17240000,17300000,17400000,17450000,17540000,17660000,17750000,17830000,17940000,18080000,18290000,18560000,18850000,19070000,19210000,19360000,19440000,19570000,19690000,19770000,19850000,19960000,20040000,20170000,20260000,20350000,20450000,20570000,20700000,20840000,20950000,21040000,21190000,21330000,21450000,21610000,21670000,21740000,21850000,21930000,22020000,22180000,22290000,22420000,22550000,22700000,22890000,23080000,23240000,23490000,23830000,24020000,24190000,24290000,24430000,24560000,24720000,24830000,24970000,25120000,25240000,25330000,25540000,25680000,25820000,25940000,26040000,26120000,26210000,26290000,26400000,26510000,26630000,26700000,26930000,27080000,27270000,27450000,27630000,27850000,27990000,28090000,28180000,28230000,28300000,28390000,28460000,28490000,28600000,28710000,28850000,28950000,29110000,29280000,29510000,29770000,30090000,30380000,30730000,31080000,31370000,31590000,31700000,31800000,31950000,32110000,32210000,32370000,32490000,32590000,32690000,32770000,32870000,32990000,33110000,33240000,33310000,33430000,33520000,33610000,33720000,33820000,33960000,34130000,34260000,34340000,34450000,34580000,34740000,34850000,34960000,35080000,35180000,35280000,35360000,35450000,35520000,35580000,35640222,35760000,35800000,35870000,36010000,36100000,36180000,36240000,36370000,36460000,36620000,36690000,36850000,36950000,37060000,37270000,37450000,37590000,37790000,38040000,38330000,38650000,38960000,39270000,39650000,39840000,39940000,40150000,40470000,40590000,40700000,40810000,40900000,41010000,41140000,41230000,41320000,41430000,41520000,41630000,41750000,41880000,42000000,42140000,42220000,42300000,42430000,42520000,42620000,42700000,42770000,42840000,42980000,43070000,43190000,43320000,43510000,43720000,43940000,44220000,44550000,44670000,44780000,44910000,45040000,45100000,45220000,45350000,45450000,45580000,45710000,45810000,45890000,45930000,46010000,46060000,46190000,46370000,46560000,46860000,47110000,47370000,47570000,47880000,48080000,48330000,48600000,48790000,49180000,49560000,50070000,50330000,50610000,50690000,50750000,50830000,50900000,50960000,51050262,51140000,51280000,51340000,51410000,51550000,51660000,51740000,51830000,51950000,52000279,52070000,52140000,52190000,52380000,52680000,52970000,53190000,53540000,53930000,54120000,54280000,54500050,54730000,55040000,55290000,55680000,55860000,56140000,56490000,56890000,57290000,57760000,58050000,58370000,58750000,58960000,59240000,59590000,60010000,60360000,60680000,61090000,61340000,61720000,62150000'.split(',')[cell]); }
    function validMarkRecitation(d) {
      let r=get(/databases/$(database)/documents/katatib_learning/$(d.recitationId)).data;
      let n=(int(warshSurah(d.surah)[0])+d.ayah)*10000;
      return r.studentId == d.studentId &&
        (('passage' in r) ? (r.passage.start < n+10000 && r.passage.end > n) :
         (learningBoundary((r.hizb-1)*8+r.fromEighth-1) < n+10000 && learningBoundary((r.hizb-1)*8+r.toEighth) > n));
    }
    match /katatib_verse_marks/{id} {
      allow get: if member() && (!exists(/databases/$(database)/documents/katatib_verse_marks/$(id)) || historyAllowed(resource.data));
      allow list: if request.query.limit <= 100 && historyAllowed(resource.data);
      allow create: if staff() && historyAllowed(request.resource.data) && id.matches('[A-Za-z0-9-]{16,80}') &&
        request.resource.data.keys().hasOnly(['schemaVersion','studentId','edition','sourceVersion','page','surah','ayah','mark','note','createdBy','createdAt','recitationId']) &&
        (!('recitationId' in request.resource.data) || (request.resource.data.recitationId is string && validMarkRecitation(request.resource.data))) &&
        request.resource.data.schemaVersion == 1 && validWarshVerse(request.resource.data) && request.resource.data.mark in ['forgot','hesitated','error','correct'] &&
        request.resource.data.note is string && request.resource.data.note.size() <= 500 && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }


    match /{document=**} { allow read, write: if false; }
  }
}
