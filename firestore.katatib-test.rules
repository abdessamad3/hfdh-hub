rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null && request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com' &&
        request.auth.token.get('email', null) is string;
    }
    function codedAddress(address) { return address.matches('[a-z2-7]{20}@students[.]katatib[.]invalid'); }
    function codeUser() {
      return request.auth != null && request.auth.token.get('email',null) is string &&
        request.auth.token.get('firebase',{}).get('sign_in_provider','') == 'password' && codedAddress(request.auth.token.email);
    }
    function email() { return request.auth.token.email.lower(); }
    function access() { return get(/databases/$(database)/documents/katatib_access/$(email())).data; }
    function member() {
      return (googleUser() || codeUser()) && exists(/databases/$(database)/documents/katatib_access/$(email())) &&
        access().get('active', false) == true && access().get('role', '') in ['admin', 'manager', 'teacher', 'parent', 'student'] &&
        (googleUser() || access().role == 'student' && access().get('authUid','') == request.auth.uid &&
          access().studentIds.size() == 1 && access().kuttabNames.size() == 0 && access().teacherIds.size() == 0 &&
          get(/databases/$(database)/documents/katatib_student_credentials/$(access().studentIds[0])).data.address == email());
    }
    function scopeAllowed(data) {
      let a = access();
      return a.role == 'admin' || (a.role in ['manager','teacher'] &&
        (data.get('kuttabName','') in a.get('kuttabNames',[]) || data.get('teacherId','') in a.get('teacherIds',[])));
    }
    function studentAllowed(data) { return member() && scopeAllowed(data); }
    function staff() { return member() && access().role in ['admin','manager','teacher']; }
    function linkedStudent(id) { return member() && access().role in ['parent','student'] && id in access().get('studentIds', []); }
    function studentIdAllowed(id) {
      let a = access();
      return member() && (a.role in ['parent','student'] ? id in a.get('studentIds',[]) :
        (exists(/databases/$(database)/documents/students/$(id)) ? scopeAllowed(get(/databases/$(database)/documents/students/$(id)).data) :
         exists(/databases/$(database)/documents/katatib_students/$(id)) && scopeAllowed(get(/databases/$(database)/documents/katatib_students/$(id)).data)));
    }
    function historyAllowed(data) {
      return data.get('studentId', null) is string &&
        studentIdAllowed(data.studentId);
    }
    function teacherScope(data,id) {
      return manage() && data.get('role','') == 'teacher' &&
        (access().role == 'admin' || data.get('kuttabName','') in access().get('kuttabNames',[]) || id in access().get('teacherIds',[]));
    }
    function teacherAllowed(id) {
      return id is string && exists(/databases/$(database)/documents/users/$(id)) &&
        teacherScope(get(/databases/$(database)/documents/users/$(id)).data,id);
    }
    match /users/{id} {
      allow get: if teacherScope(resource.data,id);
      allow list: if request.query.limit <= 100 && teacherScope(resource.data,id);
      allow write: if false;
    }
    match /teacher_attendance/{id} {
      allow get: if teacherAllowed(resource.data.teacherId);
      allow list: if request.query.limit <= 100 && teacherAllowed(resource.data.teacherId);
      allow write: if false;
    }
    function teacherDate(value) {
      let parts=value.split('-');
      let year=int(parts[0]);
      let month=int(parts[1]);
      let day=int(parts[2]);
      let leap=year % 400 == 0 || year % 4 == 0 && year % 100 != 0;
      return year >= 1 && day <= (month == 2 ? (leap ? 29 : 28) : (month in [4,6,9,11] ? 30 : 31));
    }
    function validTeacherAttendance(d,id) {
      return d.keys().hasAll(['schemaVersion','recordId','teacherId','date','session','status','note','revision','updatedBy','updatedAt','eventId']) &&
        d.keys().hasOnly(['schemaVersion','recordId','teacherId','date','session','status','note','revision','updatedBy','updatedAt','eventId']) &&
        d.schemaVersion == 1 && d.recordId == id && d.teacherId is string && d.teacherId.size() > 0 && d.teacherId.size() <= 500 && !d.teacherId.matches('.*[~/].*') &&
        d.date is string && d.date.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])') && teacherDate(d.date) &&
        d.session in ['morning','afternoon','evening'] && id == d.teacherId + '~' + d.date + '~' + d.session &&
        d.status in ['present','absent','excused','late','leftEarly','unmarked'] && d.note is string && d.note.size() <= 500 &&
        d.revision is int && d.revision > 0 && d.updatedBy == request.auth.uid && d.updatedAt == request.time &&
        d.eventId is string && d.eventId.matches('[A-Za-z0-9-]{16,80}') && teacherAllowed(d.teacherId);
    }
    function teacherHistoryAppended(d) {
      return !exists(/databases/$(database)/documents/katatib_teacher_attendance_history/$(d.eventId)) &&
        getAfter(/databases/$(database)/documents/katatib_teacher_attendance_history/$(d.eventId)).data == d;
    }
    match /katatib_teacher_attendance/{id} {
      allow get: if manage() && (!exists(/databases/$(database)/documents/katatib_teacher_attendance/$(id)) || teacherAllowed(resource.data.teacherId));
      allow list: if request.query.limit <= 100 && teacherAllowed(resource.data.teacherId);
      allow create: if validTeacherAttendance(request.resource.data,id) && request.resource.data.revision == 1 && teacherHistoryAppended(request.resource.data);
      allow update: if validTeacherAttendance(request.resource.data,id) && request.resource.data.teacherId == resource.data.teacherId &&
        request.resource.data.date == resource.data.date && request.resource.data.session == resource.data.session &&
        request.resource.data.revision == resource.data.revision + 1 && teacherHistoryAppended(request.resource.data);
      allow delete: if false;
    }
    match /katatib_teacher_attendance_history/{id} {
      allow get: if teacherAllowed(resource.data.teacherId);
      allow list: if request.query.limit <= 100 && teacherAllowed(resource.data.teacherId);
      allow create: if request.resource.data.eventId == id && validTeacherAttendance(request.resource.data,request.resource.data.recordId) &&
        getAfter(/databases/$(database)/documents/katatib_teacher_attendance/$(request.resource.data.recordId)).data == request.resource.data;
      allow update, delete: if false;
    }
    match /katatib_access/{address} {
      allow get: if member() && access().role == 'admin' || (googleUser() || codeUser()) && address == email();
      allow list: if member() && access().role == 'admin' && request.query.limit <= 100;
      allow create, update: if member() && access().role == 'admin' && address != email() && validAccess(request.resource.data, address) && workspaceRevision() && audited('katatib_access',address,request.resource.data);
      allow delete: if false;
    }
    match /students/{id} {
      allow get: if staff() && !exists(/databases/$(database)/documents/students/$(id)) || studentAllowed(resource.data) || linkedStudent(id);
      allow list: if request.query.limit <= 100 && (studentAllowed(resource.data) || linkedStudent(id));
      allow write: if false;
    }
    match /attendance/{id} {
      allow get: if historyAllowed(resource.data);
      allow list: if request.query.limit <= 100 && historyAllowed(resource.data);
      allow write: if false;
    }
    // Copied legacy activities are readable only through the student's actual scope.
    match /{legacyCollection}/{id} {
      allow get: if legacyCollection in ['evaluations','revisions','memorizations','next_revisions','next_evaluations'] && historyAllowed(resource.data);
      allow list: if legacyCollection in ['evaluations','revisions','memorizations','next_revisions','next_evaluations'] && request.query.limit <= 100 && historyAllowed(resource.data);
      allow write: if false;
    }
    function validAttendance(d, id) {
      return d.keys().hasAll(['schemaVersion', 'recordId', 'studentId', 'date', 'session', 'status', 'note', 'revision', 'updatedBy', 'updatedAt', 'eventId']) &&
        d.keys().hasOnly(['schemaVersion', 'recordId', 'studentId', 'date', 'session', 'status', 'note', 'revision', 'updatedBy', 'updatedAt', 'eventId']) &&
        d.schemaVersion == 1 && d.recordId == id &&
        d.studentId is string && d.studentId.size() > 0 && d.studentId.size() <= 500 && !d.studentId.matches('.*[~/].*') &&
        d.date is string && d.date.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])') &&
        d.session in ['morning', 'afternoon', 'evening'] && id == d.studentId + '~' + d.date + '~' + d.session &&
        d.status in ['present', 'absent', 'excused', 'late', 'leftEarly', 'unmarked'] &&
        d.note is string && d.note.size() <= 500 && d.revision is int && d.revision > 0 &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time &&
        staff() && d.eventId is string && d.eventId.matches('[A-Za-z0-9-]{16,80}') && historyAllowed(d);
    }
    function appendedHistory(d) {
      return !exists(/databases/$(database)/documents/katatib_attendance_history/$(d.eventId)) &&
        getAfter(/databases/$(database)/documents/katatib_attendance_history/$(d.eventId)).data == d;
    }
    match /katatib_attendance/{id} {
      // Missing records contain no student data. Creation is checked against the actual student.
      allow get: if member() && (!exists(/databases/$(database)/documents/katatib_attendance/$(id)) || historyAllowed(resource.data));
      allow list: if request.query.limit <= 100 && historyAllowed(resource.data);
      allow create: if validAttendance(request.resource.data, id) && request.resource.data.revision == 1 && appendedHistory(request.resource.data);
      allow update: if validAttendance(request.resource.data, id) &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.date == resource.data.date && request.resource.data.session == resource.data.session &&
        request.resource.data.revision == resource.data.revision + 1 && appendedHistory(request.resource.data);
      allow delete: if false;
    }
    match /katatib_attendance_history/{id} {
      allow get: if historyAllowed(resource.data);
      allow list: if request.query.limit <= 100 && historyAllowed(resource.data);
      allow create: if request.resource.data.eventId == id &&
        validAttendance(request.resource.data, request.resource.data.recordId) &&
        getAfter(/databases/$(database)/documents/katatib_attendance/$(request.resource.data.recordId)).data == request.resource.data;
      allow update, delete: if false;
    }
    function validLearning(d, id) {
      return id.matches('[A-Za-z0-9-]{16,80}') &&
        d.keys().hasAll(['schemaVersion','studentId','kind','date','session','hizb','fromEighth','toEighth','quantity','mistakes','score','note','supersedesId','createdBy','createdAt']) &&
        d.keys().hasOnly(['schemaVersion','studentId','kind','date','session','hizb','fromEighth','toEighth','quantity','mistakes','score','note','supersedesId','createdBy','createdAt']) &&
        d.schemaVersion == 2 && staff() && historyAllowed(d) &&
        d.kind in ['memorization','practice','revision','evaluation'] &&
        d.date is string && d.date.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])') &&
        d.session in ['morning','afternoon','evening'] &&
        d.hizb is int && d.hizb >= 1 && d.hizb <= 60 &&
        d.fromEighth is int && d.fromEighth >= 1 && d.fromEighth <= 8 &&
        d.toEighth is int && d.toEighth >= d.fromEighth && d.toEighth <= 8 &&
        d.quantity is int && d.quantity == d.toEighth - d.fromEighth + 1 &&
        ((d.kind in ['memorization','practice'] && d.mistakes == null && d.score == null) ||
         (d.kind in ['revision','evaluation'] && d.mistakes is int && d.mistakes >= 0 && d.mistakes <= 999 && d.score is int && d.score >= 0 && d.score <= 100)) &&
        d.note is string && d.note.size() <= 500 && d.createdBy == request.auth.uid && d.createdAt == request.time &&
        (d.supersedesId == null || validCorrection(d, id));
    }
    function validCorrection(d, id) {
      return d.supersedesId is string && d.supersedesId != id &&
        exists(/databases/$(database)/documents/katatib_learning/$(d.supersedesId)) &&
        get(/databases/$(database)/documents/katatib_learning/$(d.supersedesId)).data.studentId == d.studentId &&
        (get(/databases/$(database)/documents/katatib_learning/$(d.supersedesId)).data.kind == d.kind ||
         (get(/databases/$(database)/documents/katatib_learning/$(d.supersedesId)).data.kind in ['memorization','practice'] && d.kind in ['memorization','practice']));
    }
    match /katatib_learning/{id} {
      allow get: if member() && (!exists(/databases/$(database)/documents/katatib_learning/$(id)) || historyAllowed(resource.data));
      allow list: if request.query.limit <= 30 && historyAllowed(resource.data);
      allow create: if validLearning(request.resource.data, id);
      allow update, delete: if false;
    }

    function validMeta(d) {
      return d.schemaVersion == 1 && d.revision is int && d.revision > 0 && d.updatedBy == request.auth.uid && d.updatedAt == request.time && d.eventId is string && d.eventId.matches('[A-Za-z0-9_-]{1,128}');
    }
    function workspaceRevision() { return request.resource.data.revision == (request.method == 'create' ? 1 : resource.data.get('revision',0) + 1); }
    function audited(c,id,d) {
      return !exists(/databases/$(database)/documents/katatib_audit/$(d.eventId)) &&
        getAfter(/databases/$(database)/documents/katatib_audit/$(d.eventId)).data == {'collection':c,'recordId':id,'snapshot':d};
    }
    function manage() { return member() && access().role in ['admin','manager']; }
    function validProfile(d,id) {
      return d.keys().hasOnly(['schemaVersion','name','kuttabName','teacherId','group','age','status','source','revision','updatedBy','updatedAt','eventId']) && validMeta(d) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 120 && d.kuttabName is string && d.kuttabName.size() > 0 && d.kuttabName.size() <= 120 &&
        d.teacherId is string && d.teacherId.size() <= 128 && d.group is string && d.group.size() <= 80 &&
        (d.age == null || d.age is int && d.age >= 1 && d.age <= 120) && d.status in ['active','archived'] &&
        ((d.source == 'copy' && exists(/databases/$(database)/documents/students/$(id)) &&
          d.kuttabName == get(/databases/$(database)/documents/students/$(id)).data.get('kuttabName','') &&
          d.teacherId == get(/databases/$(database)/documents/students/$(id)).data.get('teacherId','')) ||
         (d.source == 'new' && !exists(/databases/$(database)/documents/students/$(id)))) && studentAllowed(d);
    }
    match /katatib_students/{id} {
      allow get: if member() && (!exists(/databases/$(database)/documents/katatib_students/$(id)) || linkedStudent(id) || studentAllowed(resource.data));
      allow list: if request.query.limit <= 100 && (studentAllowed(resource.data) || linkedStudent(id));
      allow create: if manage() && validProfile(request.resource.data,id) && request.resource.data.revision == 1 && audited('katatib_students',id,request.resource.data);
      allow update: if manage() && studentAllowed(resource.data) && validProfile(request.resource.data,id) && workspaceRevision() &&
        request.resource.data.source == resource.data.source && request.resource.data.kuttabName == resource.data.kuttabName && request.resource.data.teacherId == resource.data.teacherId && audited('katatib_students',id,request.resource.data);
      allow delete: if false;
    }
    function validTask(d) {
      return d.keys().hasOnly(['schemaVersion','studentId','kind','due','hizb','fromEighth','toEighth','note','status','revision','updatedBy','updatedAt','eventId']) && validMeta(d) && historyAllowed(d) &&
        d.kind in ['memorization','revision','evaluation'] && d.status in ['planned','done','cancelled'] &&
        d.due is string && d.due.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])') &&
        d.hizb is int && d.hizb >= 1 && d.hizb <= 60 && d.fromEighth is int && d.fromEighth >= 1 && d.fromEighth <= 8 && d.toEighth is int && d.toEighth >= d.fromEighth && d.toEighth <= 8 &&
        d.note is string && d.note.size() <= 500;
    }
    match /katatib_tasks/{id} {
      allow get: if member() && (!exists(/databases/$(database)/documents/katatib_tasks/$(id)) || historyAllowed(resource.data));
      allow list: if request.query.limit <= 100 && historyAllowed(resource.data);
      allow create: if staff() && validTask(request.resource.data) && request.resource.data.revision == 1 && audited('katatib_tasks',id,request.resource.data);
      allow update: if staff() && validTask(request.resource.data) && request.resource.data.studentId == resource.data.studentId && workspaceRevision() && audited('katatib_tasks',id,request.resource.data);
      allow delete: if false;
    }
    function validAccess(d,address) {
      return d.keys().hasOnly(['schemaVersion','active','role','kuttabNames','teacherIds','studentIds','authUid','revision','updatedBy','updatedAt','eventId']) && validMeta(d) &&
        address.matches('[^/ @]+@[^/ @]+\\.[^/ @]+') && address == address.lower() &&
        d.active is bool && d.role in ['admin','manager','teacher','parent','student'] &&
        (!codedAddress(address) ? !d.keys().hasAny(['authUid']) :
          d.role == 'student' && d.studentIds.size() == 1 && d.teacherIds.size() == 0 && d.kuttabNames.size() == 0 &&
          d.authUid is string && d.authUid.size() > 0 && d.authUid.size() <= 128 &&
          (!d.active || getAfter(/databases/$(database)/documents/katatib_student_credentials/$(d.studentIds[0])).data.address == address &&
            getAfter(/databases/$(database)/documents/katatib_student_credentials/$(d.studentIds[0])).data.authUid == d.authUid)) &&
        d.kuttabNames is list && d.kuttabNames.size() <= 10 && d.teacherIds is list && d.teacherIds.size() <= 10 && d.studentIds is list && d.studentIds.size() <= 10 &&
        (d.role == 'admin' || (d.role in ['parent','student'] ? d.studentIds.size() > 0 : d.kuttabNames.size() + d.teacherIds.size() > 0));
    }
    function validCredential(d,id) {
      let grant=getAfter(/databases/$(database)/documents/katatib_access/$(d.address)).data;
      return d.keys().hasOnly(['schemaVersion','studentId','address','authUid','revision','updatedBy','updatedAt','eventId']) &&
        validMeta(d) && d.studentId == id && studentIdAllowed(id) && codedAddress(d.address) &&
        grant.active == true && grant.role == 'student' && grant.authUid == d.authUid && grant.studentIds == [id] &&
        audited('katatib_student_credentials',id,d);
    }
    match /katatib_student_credentials/{id} {
      allow get: if member() && access().role == 'admin';
      allow list: if member() && access().role == 'admin' && request.query.limit <= 100;
      allow create: if member() && access().role == 'admin' && validCredential(request.resource.data,id) && request.resource.data.revision == 1;
      allow update: if member() && access().role == 'admin' && validCredential(request.resource.data,id) && workspaceRevision() &&
        request.resource.data.address != resource.data.address &&
        getAfter(/databases/$(database)/documents/katatib_access/$(resource.data.address)).data.active == false;
      allow delete: if false;
    }
    match /katatib_audit/{id} {
      allow get, list: if member() && (access().role == 'admin' || resource.data.collection in ['katatib_legacy_corrections','katatib_legacy_task_states'] && historyAllowed(resource.data.snapshot)) && (request.method == 'get' || request.query.limit <= 100);
      allow create: if member() && request.resource.data.keys().hasOnly(['collection','recordId','snapshot']) &&
        request.resource.data.collection in ['katatib_students','katatib_tasks','katatib_access','katatib_schedules','katatib_legacy_corrections','katatib_questions','katatib_challenge_attempts','katatib_legacy_task_states','katatib_student_credentials','katatib_notices','katatib_notice_acks','katatib_consents'] &&
        request.resource.data.recordId is string && request.resource.data.snapshot.eventId == id &&
        request.resource.data.snapshot.updatedBy == request.auth.uid && request.resource.data.snapshot.updatedAt == request.time &&
        getAfter(/databases/$(database)/documents/$(request.resource.data.collection)/$(request.resource.data.recordId)).data == request.resource.data.snapshot;
      allow update, delete: if false;
    }
    function kuttabScope(d) {
      return staff() && (access().role == 'admin' || d.get('name','') in access().get('kuttabNames',[]) || d.get('teacherId','') in access().get('teacherIds',[]));
    }
    function kuttabAllowed(id) { return id is string && exists(/databases/$(database)/documents/kuttabs/$(id)) && kuttabScope(get(/databases/$(database)/documents/kuttabs/$(id)).data); }
    match /kuttabs/{id} {
      allow get: if kuttabScope(resource.data);
      allow list: if request.query.limit <= 100 && kuttabScope(resource.data);
      allow write: if false;
    }
    function clockTime(t) { return t is string && (t == '' || t.matches('([01][0-9]|2[0-3]):[0-5][0-9]')); }
    function calendarDate(t) { return t is string && t.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])') && teacherDate(t); }
    function boundedNullable(v,min,max) { return v == null || v is int && v >= min && v <= max; }
    function validSchedule(d,id) {
      return d.keys().hasOnly(['schemaVersion','kuttabId','key','morning','afternoon','evening','note','revision','updatedBy','updatedAt','eventId']) && validMeta(d) && manage() && kuttabAllowed(d.kuttabId) &&
        d.key is string && (d.key.matches('[0-6]') || calendarDate(d.key)) && id == d.kuttabId + '~' + d.key &&
        clockTime(d.morning) && clockTime(d.afternoon) && clockTime(d.evening) &&
        (d.morning == '' || d.morning != d.afternoon && d.morning != d.evening) && (d.afternoon == '' || d.afternoon != d.evening) && d.note is string && d.note.size() <= 500;
    }
    match /katatib_schedules/{id} {
      allow get: if staff() && (!exists(/databases/$(database)/documents/katatib_schedules/$(id)) || kuttabAllowed(resource.data.kuttabId));
      allow list: if request.query.limit <= 100 && kuttabAllowed(resource.data.kuttabId);
      allow create: if validSchedule(request.resource.data,id) && request.resource.data.revision == 1 && audited('katatib_schedules',id,request.resource.data);
      allow update: if validSchedule(request.resource.data,id) && workspaceRevision() && request.resource.data.kuttabId == resource.data.kuttabId && request.resource.data.key == resource.data.key && audited('katatib_schedules',id,request.resource.data);
      allow delete: if false;
    }
    function validLegacyCorrection(d,id) {
      return d.keys().hasOnly(['schemaVersion','sourceCollection','sourceId','studentId','date','hizb','quantity','identifier','surah','fromAyah','toAyah','mistakes','score','note','reason','revision','updatedBy','updatedAt','eventId']) && validMeta(d) && staff() && historyAllowed(d) &&
        d.sourceCollection in ['evaluations','revisions','memorizations'] && d.sourceId is string && d.sourceId.size() > 0 && d.sourceId.size() <= 128 && !d.sourceId.matches('.*[~/].*') &&
        id == d.sourceCollection + '~' + d.sourceId && exists(/databases/$(database)/documents/$(d.sourceCollection)/$(d.sourceId)) && get(/databases/$(database)/documents/$(d.sourceCollection)/$(d.sourceId)).data.studentId == d.studentId &&
        calendarDate(d.date) && boundedNullable(d.hizb,1,60) && boundedNullable(d.quantity,1,8) && boundedNullable(d.mistakes,0,999) && boundedNullable(d.score,0,100) &&
        boundedNullable(d.fromAyah,1,286) && boundedNullable(d.toAyah,1,286) && (d.fromAyah == null || d.toAyah == null || d.fromAyah <= d.toAyah) &&
        d.identifier is string && d.identifier.size() <= 120 && d.surah is string && d.surah.size() <= 120 && d.note is string && d.note.size() <= 500 && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 500;
    }
    match /katatib_legacy_corrections/{id} {
      allow get: if member() && (!exists(/databases/$(database)/documents/katatib_legacy_corrections/$(id)) || historyAllowed(resource.data));
      allow list: if request.query.limit <= 100 && historyAllowed(resource.data);
      allow create: if validLegacyCorrection(request.resource.data,id) && request.resource.data.revision == 1 && audited('katatib_legacy_corrections',id,request.resource.data);
      allow update: if validLegacyCorrection(request.resource.data,id) && workspaceRevision() && request.resource.data.sourceCollection == resource.data.sourceCollection && request.resource.data.sourceId == resource.data.sourceId && request.resource.data.studentId == resource.data.studentId && audited('katatib_legacy_corrections',id,request.resource.data);
      allow delete: if false;
    }
    match /smart_questions/{id} {
      allow get: if member() && access().role == 'admin';
      allow list: if member() && access().role == 'admin' && request.query.limit <= 100;
      allow write: if false;
    }
    function questionOption(v) { return v is string && v.size() > 0 && v.size() <= 1000; }
    function validLegacyTaskState(d,id) {
      return d.keys().hasOnly(['schemaVersion','sourceCollection','sourceId','studentId','status','note','revision','updatedBy','updatedAt','eventId']) && validMeta(d) && staff() && historyAllowed(d) &&
        d.sourceCollection in ['next_revisions','next_evaluations'] && d.sourceId is string && d.sourceId.size() > 0 && d.sourceId.size() <= 128 && !d.sourceId.matches('.*[~/].*') &&
        id == d.sourceCollection + '~' + d.sourceId && exists(/databases/$(database)/documents/$(d.sourceCollection)/$(d.sourceId)) && get(/databases/$(database)/documents/$(d.sourceCollection)/$(d.sourceId)).data.studentId == d.studentId &&
        d.status in ['planned','done','cancelled'] && d.note is string && d.note.size() <= 500;
    }
    match /katatib_legacy_task_states/{id} {
      allow get: if member() && (!exists(/databases/$(database)/documents/katatib_legacy_task_states/$(id)) || historyAllowed(resource.data));
      allow list: if request.query.limit <= 100 && historyAllowed(resource.data);
      allow create: if validLegacyTaskState(request.resource.data,id) && request.resource.data.revision == 1 && audited('katatib_legacy_task_states',id,request.resource.data);
      allow update: if validLegacyTaskState(request.resource.data,id) && workspaceRevision() && request.resource.data.sourceCollection == resource.data.sourceCollection && request.resource.data.sourceId == resource.data.sourceId && request.resource.data.studentId == resource.data.studentId && audited('katatib_legacy_task_states',id,request.resource.data);
      allow delete: if false;
    }
    function validQuestion(d) {
      return d.keys().hasOnly(['schemaVersion','prompt','options','answerIndex','edition','reference','active','reviewed','sourceId','revision','updatedBy','updatedAt','eventId']) && validMeta(d) && member() && access().role == 'admin' &&
        d.prompt is string && d.prompt.size() > 0 && d.prompt.size() <= 2000 && d.options is list && d.options.size() >= 2 && d.options.size() <= 4 &&
        questionOption(d.options[0]) && questionOption(d.options[1]) && (d.options.size() < 3 || questionOption(d.options[2])) && (d.options.size() < 4 || questionOption(d.options[3])) && d.options.toSet().size() == d.options.size() &&
        d.answerIndex is int && d.answerIndex >= 0 && d.answerIndex < d.options.size() && d.edition in ['warsh','general'] &&
        d.reference is string && d.reference.size() > 0 && d.reference.size() <= 500 && d.active is bool && d.reviewed == true && d.sourceId is string &&
        (d.sourceId == '' || d.sourceId.size() <= 128 && !d.sourceId.matches('.*[~/].*') && exists(/databases/$(database)/documents/smart_questions/$(d.sourceId)));
    }
    match /katatib_questions/{id} {
      allow get: if member() && (!exists(/databases/$(database)/documents/katatib_questions/$(id)) || access().role == 'admin' || resource.data.active == true && resource.data.reviewed == true);
      allow list: if member() && request.query.limit <= 100 && (access().role == 'admin' || resource.data.active == true && resource.data.reviewed == true);
      allow create: if validQuestion(request.resource.data) && request.resource.data.revision == 1 && audited('katatib_questions',id,request.resource.data);
      allow update: if validQuestion(request.resource.data) && workspaceRevision() && request.resource.data.sourceId == resource.data.sourceId && audited('katatib_questions',id,request.resource.data);
      allow delete: if false;
    }
    function validAttempt(d) {
      let q=get(/databases/$(database)/documents/katatib_questions/$(d.questionId)).data;
      return d.keys().hasOnly(['schemaVersion','studentId','questionId','questionRevision','choice','correct','date','revision','updatedBy','updatedAt','eventId']) && validMeta(d) && historyAllowed(d) && calendarDate(d.date) &&
        q.active == true && q.reviewed == true && d.questionRevision == q.revision && d.choice is int && d.choice >= 0 && d.choice < q.options.size() && d.correct is bool && d.correct == (d.choice == q.answerIndex);
    }
    match /katatib_challenge_attempts/{id} {
      allow get: if member() && (!exists(/databases/$(database)/documents/katatib_challenge_attempts/$(id)) || historyAllowed(resource.data));
      allow list: if request.query.limit <= 100 && historyAllowed(resource.data);
      allow create: if validAttempt(request.resource.data) && request.resource.data.revision == 1 && audited('katatib_challenge_attempts',id,request.resource.data);
      allow update, delete: if false;
    }

    function validNotice(d) {
      return d.keys().hasOnly(['schemaVersion','studentId','title','body','kind','active','revision','updatedBy','updatedAt','eventId']) && validMeta(d) && staff() && historyAllowed(d) &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 120 && d.body is string && d.body.size() > 0 && d.body.size() <= 2000 &&
        d.kind in ['info','attendance','learning'] && d.active is bool;
    }
    match /katatib_notices/{id} {
      allow get: if member() && (!exists(/databases/$(database)/documents/katatib_notices/$(id)) || historyAllowed(resource.data));
      allow list: if request.query.limit <= 100 && historyAllowed(resource.data);
      allow create: if validNotice(request.resource.data) && request.resource.data.revision == 1 && audited('katatib_notices',id,request.resource.data);
      allow update: if validNotice(request.resource.data) && workspaceRevision() && request.resource.data.studentId == resource.data.studentId && audited('katatib_notices',id,request.resource.data);
      allow delete: if false;
    }
    function validNoticeAck(d,id) {
      let notice=get(/databases/$(database)/documents/katatib_notices/$(d.noticeId)).data;
      return d.keys().hasOnly(['schemaVersion','studentId','noticeId','readerUid','noticeRevision','revision','updatedBy','updatedAt','eventId']) && validMeta(d) &&
        historyAllowed(d) && d.readerUid == request.auth.uid && notice.studentId == d.studentId && notice.active == true && d.noticeRevision == notice.revision &&
        id == d.noticeId + '~' + string(d.noticeRevision) + '~' + d.readerUid && d.revision == 1 && audited('katatib_notice_acks',id,d);
    }
    match /katatib_notice_acks/{id} {
      allow get: if member() && (!exists(/databases/$(database)/documents/katatib_notice_acks/$(id)) || resource.data.readerUid == request.auth.uid && historyAllowed(resource.data));
      allow list: if member() && request.query.limit <= 100 && resource.data.readerUid == request.auth.uid && historyAllowed(resource.data);
      allow create: if validNoticeAck(request.resource.data,id);
      allow update, delete: if false;
    }
    function validConsent(d,id) {
      return d.keys().hasOnly(['schemaVersion','studentId','guardianUid','purpose','approved','policyVersion','revision','updatedBy','updatedAt','eventId']) && validMeta(d) && member() &&
        access().role == 'parent' && linkedStudent(d.studentId) && d.guardianUid == request.auth.uid &&
        d.purpose in ['audio','ranking'] && d.approved is bool && d.policyVersion == 'katatib-test-2026-10-19' &&
        id == d.guardianUid + '~' + d.studentId + '~' + d.purpose && audited('katatib_consents',id,d);
    }
    match /katatib_consents/{id} {
      allow get: if member() && (!exists(/databases/$(database)/documents/katatib_consents/$(id)) || historyAllowed(resource.data));
      allow list: if request.query.limit <= 100 && historyAllowed(resource.data);
      allow create: if validConsent(request.resource.data,id) && request.resource.data.revision == 1;
      allow update: if validConsent(request.resource.data,id) && workspaceRevision() && request.resource.data.studentId == resource.data.studentId && request.resource.data.guardianUid == resource.data.guardianUid && request.resource.data.purpose == resource.data.purpose;
      allow delete: if false;
    }

