rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    function belongsToStudent(studentId) {
      return isStudent() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == studentId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // Sub-collections helpers
    function canAccessStudentSubData(data) {
      return isTeacher() || belongsToStudent(data.studentId);
    }

    // Attendance
    match /attendance/{id} {
      allow list: if isSignedIn() && canAccessStudentSubData(resource.data);
      allow get: if isSignedIn() && canAccessStudentSubData(resource.data);
      allow write: if isTeacher();
    }

    // Memorizations
    match /memorizations/{id} {
      allow list: if isSignedIn() && canAccessStudentSubData(resource.data);
      allow get: if isSignedIn() && canAccessStudentSubData(resource.data);
      allow write: if isTeacher();
    }

    // Evaluations
    match /evaluations/{id} {
      allow list: if isSignedIn() && canAccessStudentSubData(resource.data);
      allow get: if isSignedIn() && canAccessStudentSubData(resource.data);
      allow write: if isTeacher();
    }

    // Revisions
    match /revisions/{id} {
      allow list: if isSignedIn() && canAccessStudentSubData(resource.data);
      allow get: if isSignedIn() && canAccessStudentSubData(resource.data);
      allow write: if isTeacher();
    }
  }
}
