rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'abdessamadjibrane2@gmail.com' ||
        request.auth.token.email.lower() == 'rachid.houlla@gmail.com' ||
        request.auth.token.email.lower() == 'locatortradi@gmail.com' ||
        (hasProfile() && getUserData().get('role', 'none') == 'admin')
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        isAdmin() || 
        (hasProfile() && getUserData().get('role', 'none') == 'teacher')
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles
    match /users/{uid} {
      allow get: if isSignedIn() && (isAdmin() || request.auth.uid == uid || resource.data.email == request.auth.token.email);
      allow list: if isSignedIn() && (isAdmin() || resource.data.email == request.auth.token.email);
      allow create: if isSignedIn() && (isAdmin() || request.auth.uid == uid || request.resource.data.email == request.auth.token.email);
      allow update: if isSignedIn() && (isAdmin() || request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    // Kuttabs
    match /kuttabs/{kuttabId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    // Login History
    match /login_history/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list: if isAdmin();
    }

    // Relational Helpers for data access
    function canAccessStudent(data) {
      let email = request.auth.token.email.lower();
      let uid = request.auth.uid;
      return isAdmin() || 
             data.teacherId == uid || 
             data.kuttabResponsibleId == uid || 
             data.get('email', '').lower() == email ||
             (isTeacher() && hasProfile() && data.get('kuttabName', '') != '' && data.kuttabName == getUserData().get('kuttabName', ''));
    }

    function canAccessSubData(data) {
      let email = request.auth.token.email.lower();
      let uid = request.auth.uid;
      return isAdmin() || 
             data.teacherId == uid || 
             data.kuttabResponsibleId == uid || 
             data.get('studentEmail', '').lower() == email ||
             (isTeacher() && hasProfile() && data.get('kuttabName', '') != '' && data.kuttabName == getUserData().get('kuttabName', ''));
    }

    // Students
    match /students/{studentId} {
      allow get: if isSignedIn() && canAccessStudent(resource.data);
      allow list: if isSignedIn() && (
        isAdmin() || 
        (isTeacher() && request.query.limit <= 100) || 
        resource.data.get('email', '').lower() == request.auth.token.email.lower()
      );
      allow create: if isTeacher();
      allow update: if isAdmin() || (isTeacher() && canAccessStudent(resource.data));
      allow delete: if isAdmin();
    }

    // Sub-data collections (Attendance, Evaluations, etc.)
    match /attendance/{id} {
      allow get: if isSignedIn() && canAccessSubData(resource.data);
      allow list: if isSignedIn() && (
        isAdmin() || 
        (isTeacher() && request.query.limit <= 100) || 
        resource.data.get('studentEmail', '').lower() == request.auth.token.email.lower()
      );
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    match /evaluations/{id} {
      allow get: if isSignedIn() && canAccessSubData(resource.data);
      allow list: if isSignedIn() && (
        isAdmin() || 
        (isTeacher() && request.query.limit <= 100) || 
        resource.data.get('studentEmail', '').lower() == request.auth.token.email.lower()
      );
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    match /memorizations/{id} {
      allow get: if isSignedIn() && canAccessSubData(resource.data);
      allow list: if isSignedIn() && (
        isAdmin() || 
        (isTeacher() && request.query.limit <= 100) || 
        resource.data.get('studentEmail', '').lower() == request.auth.token.email.lower()
      );
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    match /revisions/{id} {
      allow get: if isSignedIn() && canAccessSubData(resource.data);
      allow list: if isSignedIn() && (
        isAdmin() || 
        (isTeacher() && request.query.limit <= 100) || 
        resource.data.get('studentEmail', '').lower() == request.auth.token.email.lower()
      );
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    match /next_revisions/{id} {
      allow get: if isSignedIn() && canAccessSubData(resource.data);
      allow list: if isSignedIn() && (
        isAdmin() || 
        (isTeacher() && request.query.limit <= 100) || 
        resource.data.get('studentEmail', '').lower() == request.auth.token.email.lower()
      );
      allow create, update, delete: if isAdmin() || isTeacher();
    }
  }
}
