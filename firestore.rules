rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'abdessamadjibrane2@gmail.com' ||
        request.auth.token.email == 'rachid.houlla@gmail.com' ||
        request.auth.token.email == 'locatortradi@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'admin')
      );
    }

    function isManager() {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'manager')
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        isManager() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'teacher')
      );
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles
    match /users/{uid} {
      allow read, get, list: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == uid || isManager());
      allow update: if isSignedIn() && (request.auth.uid == uid || isManager());
      allow delete: if isAdmin();
    }

    // Kuttabs
    match /kuttabs/{kuttabId} {
      allow read, list: if isSignedIn();
      allow create: if isManager();
      allow update: if isManager() || (isTeacher() && resource.data.get('teacherId', '') == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Login History
    match /login_history/{id} {
      allow create: if isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid;
      allow read, list: if isAdmin();
    }

    // Relational Helpers for data access
    function canAccessStudent(data) {
      return isSignedIn() && (
        isManager() || 
        data.get('teacherId', '') == request.auth.uid || 
        data.get('kuttabResponsibleId', '') == request.auth.uid || 
        ('email' in request.auth.token && data.get('email', '') == request.auth.token.email) ||
        (isTeacher() && hasProfile() && data.get('kuttabName', '') != '' && data.get('kuttabName', '') == getUserData().get('kuttabName', ''))
      );
    }

    // Students
    match /students/{studentId} {
      allow read, get, list: if isSignedIn();
      allow create: if isTeacher();
      allow update: if isManager() || (isTeacher() && canAccessStudent(resource.data));
      allow delete: if isAdmin();
    }

    // Sub-data collections (Attendance, Evaluations, etc.)
    match /attendance/{id} {
      allow read, get, list: if isSignedIn();
      allow create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    match /teacher_attendance/{id} {
      allow read, get, list: if isManager();
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    match /evaluations/{id} {
      allow read, get, list: if isSignedIn();
      allow create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    match /memorizations/{id} {
      allow read, get, list: if isSignedIn();
      allow create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    match /revisions/{id} {
      allow read, get, list: if isSignedIn();
      allow create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    match /next_revisions/{id} {
      allow read, get, list: if isSignedIn();
      allow create, update, delete: if isTeacher();
    }

    match /next_evaluations/{id} {
      allow read, get, list: if isSignedIn();
      allow create, update, delete: if isTeacher();
    }

    // Smart Questions (Admin managed)
    match /smart_questions/{id} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
