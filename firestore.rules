rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Email of the signed-in user, trusted only when the provider verified it
    // (Google always does). Without this, an email/password sign-up could claim
    // any address, including an admin's.
    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return isSignedIn() && (
        (hasVerifiedEmail() && myEmail() in [
          'abdessamadjibrane2@gmail.com',
          'rachid.houlla@gmail.com',
          'locatortradi@gmail.com'
        ]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'admin')
      );
    }

    function isManager() {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'manager')
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        isManager() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'teacher')
      );
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // A user an admin/manager registered, or an enrolled student who has signed
    // in. Strangers with a Google account are not registered and can read nothing.
    function isRegistered() {
      return isAdmin() || (
        hasProfile() &&
        getUserData().get('role', 'none') in ['manager', 'teacher', 'student']
      );
    }

    // The student record exists and belongs to the signed-in user's email.
    function isOwnStudentRecord(studentId) {
      return studentId is string &&
        exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.get('email', '').lower() == myEmail();
    }

    // First sign-in: the client creates users/{uid} for itself. The role must
    // come from somewhere the user can't control: either an enrolled student
    // record with their email, or a profile a manager pre-registered for their
    // email (passed as migratedFrom, copied role and kuttab unchanged).
    function isValidSelfCreate(uid) {
      return request.auth.uid == uid && hasVerifiedEmail() &&
        request.resource.data.get('email', '') == myEmail() && (
          isAdmin() ||
          (request.resource.data.get('role', '') == 'student' &&
           !request.resource.data.keys().hasAny(['kuttabName', 'migratedFrom']) &&
           isOwnStudentRecord(request.resource.data.get('studentId', null))) ||
          isMigratedFromPreRegistration(request.resource.data)
        );
    }

    function isMigratedFromPreRegistration(data) {
      return data.get('migratedFrom', null) is string &&
        data.migratedFrom != request.auth.uid &&
        exists(/databases/$(database)/documents/users/$(data.migratedFrom)) &&
        matchesPreRegistration(data, get(/databases/$(database)/documents/users/$(data.migratedFrom)).data);
    }

    function matchesPreRegistration(data, pre) {
      return pre.get('email', '').lower() == myEmail() &&
        data.get('role', '') == pre.get('role', 'teacher') &&
        data.get('kuttabName', null) == pre.get('kuttabName', null) &&
        (!data.keys().hasAny(['studentId']) || isOwnStudentRecord(data.studentId));
    }

    // Later sign-ins: users may refresh their name/photo, but never their role,
    // kuttab, or which student record they are linked to (unless it is theirs).
    function isValidSelfUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth.uid == uid &&
        !changed.hasAny(['role', 'kuttabName', 'migratedFrom']) &&
        (!changed.hasAny(['email']) || (hasVerifiedEmail() && request.resource.data.email == myEmail())) &&
        (!changed.hasAny(['studentId']) || isOwnStudentRecord(request.resource.data.get('studentId', null)));
    }

    // Managers manage teachers/managers; only admins may grant or edit admin.
    function canManageUser(newData) {
      return isAdmin() || (isManager() && newData.get('role', 'teacher') != 'admin');
    }

    function canManageExistingUser(newData, oldData) {
      return canManageUser(newData) && (isAdmin() || oldData.get('role', '') != 'admin');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles
    match /users/{uid} {
      // Unregistered users may only look up their own profile (by id or by
      // their own email) so the sign-in flow can find their pre-registration.
      allow get: if isSignedIn() && (request.auth.uid == uid || isRegistered() ||
        (hasVerifiedEmail() && resource.data.get('email', '').lower() == myEmail()));
      allow list: if isRegistered() || (hasVerifiedEmail() && resource.data.email == myEmail());
      allow create: if isValidSelfCreate(uid) || canManageUser(request.resource.data);
      allow update: if isValidSelfUpdate(uid) || canManageExistingUser(request.resource.data, resource.data);
      // A user may remove the pre-registration doc for their own email once
      // they have migrated it into users/{their uid}.
      allow delete: if isAdmin() || (
        hasVerifiedEmail() && uid != request.auth.uid &&
        resource.data.get('email', '').lower() == myEmail() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    // Kuttabs
    match /kuttabs/{kuttabId} {
      allow read, list: if isRegistered();
      allow create: if isManager();
      allow update: if isManager() || (isTeacher() && resource.data.get('teacherId', '') == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Login History
    match /login_history/{id} {
      allow create: if isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid;
      allow read, list: if isAdmin();
    }

    // Relational Helpers for data access
    function canAccessStudent(data) {
      return isSignedIn() && (
        isManager() || 
        data.get('teacherId', '') == request.auth.uid || 
        data.get('kuttabResponsibleId', '') == request.auth.uid || 
        ('email' in request.auth.token && data.get('email', '') == request.auth.token.email) ||
        (isTeacher() && hasProfile() && data.get('kuttabName', '') != '' && data.get('kuttabName', '') == getUserData().get('kuttabName', ''))
      );
    }

    // Students
    match /students/{studentId} {
      // Unregistered users may only find their own student record at sign-in.
      allow get, list: if isRegistered() || (hasVerifiedEmail() && resource.data.email == myEmail());
      allow create: if isTeacher();
      allow update: if isManager() || (isTeacher() && canAccessStudent(resource.data));
      allow delete: if isAdmin();
    }

    // Sub-data collections (Attendance, Evaluations, etc.)
    match /attendance/{id} {
      allow read, get, list: if isRegistered();
      allow create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    match /teacher_attendance/{id} {
      allow read, get, list: if isManager();
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    match /evaluations/{id} {
      allow read, get, list: if isRegistered();
      allow create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    match /memorizations/{id} {
      allow read, get, list: if isRegistered();
      allow create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    match /revisions/{id} {
      allow read, get, list: if isRegistered();
      allow create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    match /next_revisions/{id} {
      allow read, get, list: if isRegistered();
      allow create, update, delete: if isTeacher();
    }

    match /next_evaluations/{id} {
      allow read, get, list: if isRegistered();
      allow create, update, delete: if isTeacher();
    }

    // Smart Questions (Admin managed)
    match /smart_questions/{id} {
      allow read, list: if isRegistered();
      allow create, update, delete: if isAdmin();
    }
  }
}
